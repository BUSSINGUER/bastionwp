<?php
/**
 * Plugin Name: Bastion Core
 * Description: Camada Must-Use de proteção essencial do BastionWP.
 * Version: 0.9.9.3
 * Author: Kaio Bussinguer
 */

if (!defined('ABSPATH')) {
    exit;
}

define('BASTION_CORE_VERSION', '0.9.9.3');

/**
 * Modo de emergência.
 *
 * Se for necessário desativar temporariamente as regras do Bastion Core
 * sem remover o arquivo, adicionar ao wp-config.php:
 *
 * define('BASTIONWP_DISABLE_CORE', true);
 *
 * Essa constante não corrige erros de sintaxe; por isso o instalador também
 * valida sintaxe antes de substituir o Core.
 */
if (defined('BASTIONWP_DISABLE_CORE') && BASTIONWP_DISABLE_CORE) {
    return;
}

/**
 * O MU Core deve permanecer propositalmente pequeno.
 *
 * Regras dinâmicas de UI e concessão temporária de capabilities pertencem
 * ao plugin principal. O Core mantém somente restrições essenciais que são
 * seguras mesmo se o plugin principal estiver desativado.
 */
final class BastionWP_Core
{
    private const DEVELOPERS_OPTION = 'bastionwp_developers';
    private const CLIENT_MARKER_CAP = 'bastionwp_client_manager';
    private const PROTECTED_ADMIN_META = 'bastionwp_protected_admin';
    private const PROTECTED_ADMIN_POLICY_META = 'bastionwp_protected_admin_policy';

    private static ?BastionWP_Core $instance = null;

    public static function instance(): BastionWP_Core
    {
        if (self::$instance === null) {
            self::$instance = new self();
        }

        return self::$instance;
    }

    private function __construct()
    {
        add_action('muplugins_loaded', [$this, 'boot']);
    }

    public function boot(): void
    {
        add_filter('map_meta_cap', [$this, 'protect_developer_accounts'], 1, 4);
        add_filter('map_meta_cap', [$this, 'protect_other_administrators'], 2, 4);
        add_filter('user_has_cap', [$this, 'enforce_client_capability_ceiling'], 10000, 4);
        add_filter('user_has_cap', [$this, 'enforce_protected_admin_policy'], 9900, 4);
        add_filter('rest_pre_dispatch', [$this, 'protect_critical_client_rest_routes'], 0, 3);
        add_action('admin_init', [$this, 'protect_critical_client_routes'], 1);
        add_action('admin_menu', [$this, 'hide_critical_client_menus'], 9998);

        if (!defined('BASTION_CORE_BOOTED')) {
            define('BASTION_CORE_BOOTED', true);
        }

        do_action('bastionwp_core_loaded', BASTION_CORE_VERSION);
    }

    public function protect_developer_accounts(array $caps, string $cap, int $user_id, array $args): array
    {
        if ($this->is_developer($user_id)) {
            return $caps;
        }

        if (!in_array($cap, ['edit_user', 'delete_user', 'remove_user', 'promote_user'], true)) {
            return $caps;
        }

        $target_user_id = isset($args[0]) ? absint($args[0]) : 0;

        if ($target_user_id > 0 && $this->is_developer($target_user_id)) {
            return ['do_not_allow'];
        }

        return $caps;
    }

    public function enforce_client_capability_ceiling(
        array $allcaps,
        array $caps,
        array $args,
        WP_User $user
    ): array {
        if (!$user->exists() || !in_array('bastion_client_manager', (array) $user->roles, true)) {
            return $allcaps;
        }

        foreach ($this->forbidden_client_capabilities() as $capability) {
            $allcaps[$capability] = false;
        }

        return $allcaps;
    }

    public function enforce_protected_admin_policy(
        array $allcaps,
        array $caps,
        array $args,
        WP_User $user
    ): array {
        if (!$user->exists() || !$this->is_protected_admin((int) $user->ID)) {
            return $allcaps;
        }

        $policy = $this->get_protected_admin_policy((int) $user->ID);
        $blocked = [];

        if (!empty($policy['block_file_editor'])) {
            $blocked = array_merge($blocked, ['edit_plugins', 'edit_themes', 'edit_files']);
        }
        if (!empty($policy['block_plugin_install'])) {
            $blocked[] = 'install_plugins';
        }
        if (!empty($policy['block_plugin_delete'])) {
            $blocked[] = 'delete_plugins';
        }
        if (!empty($policy['block_plugin_activation'])) {
            $blocked = array_merge($blocked, ['activate_plugins', 'deactivate_plugins']);
        }
        if (!empty($policy['block_theme_install'])) {
            $blocked[] = 'install_themes';
        }
        if (!empty($policy['block_theme_delete'])) {
            $blocked[] = 'delete_themes';
        }
        if (!empty($policy['block_theme_activation'])) {
            $blocked[] = 'switch_themes';
        }
        if (!empty($policy['block_users'])) {
            $blocked = array_merge($blocked, ['create_users', 'edit_users', 'delete_users', 'promote_users', 'remove_users', 'list_users']);
        }
        if (!empty($policy['block_updates'])) {
            $blocked = array_merge($blocked, ['update_core', 'update_plugins', 'update_themes']);
        }

        foreach (array_values(array_unique($blocked)) as $capability) {
            $allcaps[$capability] = false;
        }

        return $allcaps;
    }

    public function protect_other_administrators(array $caps, string $cap, int $user_id, array $args): array
    {
        if (!$this->is_protected_admin($user_id)) {
            return $caps;
        }

        $policy = $this->get_protected_admin_policy($user_id);
        if (empty($policy['protect_other_admins'])) {
            return $caps;
        }

        if (!in_array($cap, ['edit_user', 'delete_user', 'remove_user', 'promote_user'], true)) {
            return $caps;
        }

        $target_user_id = isset($args[0]) ? absint($args[0]) : 0;
        if ($target_user_id <= 0 || $target_user_id === $user_id) {
            return $caps;
        }

        $target = get_userdata($target_user_id);
        if ($target && in_array('administrator', (array) $target->roles, true)) {
            return ['do_not_allow'];
        }

        return $caps;
    }

    public function protect_critical_client_rest_routes($result, WP_REST_Server $server, WP_REST_Request $request)
    {
        $route = strtolower((string) $request->get_route());
        $current_user_id = get_current_user_id();

        if ($this->is_protected_admin($current_user_id)) {
            $policy = $this->get_protected_admin_policy($current_user_id);
            if (!empty($policy['block_code_tools']) && str_contains($route, 'code-snippets')) {
                return new WP_Error(
                    'bastionwp_core_protected_admin_rest_blocked',
                    __('Ferramentas de execução de PHP estão bloqueadas pelo Bastion Core para este Administrador Protegido.', 'bastionwp'),
                    ['status' => 403]
                );
            }
        }

        if (!$this->is_client_manager()) {
            return $result;
        }

        if (
            str_contains($route, 'code-snippets')
            || str_contains($route, 'wordfence')
            || str_contains($route, '/wfls')
        ) {
            return new WP_Error(
                'bastionwp_core_rest_blocked',
                __('Esta operação REST técnica permanece bloqueada pelo Bastion Core.', 'bastionwp'),
                ['status' => 403]
            );
        }

        return $result;
    }

    public function protect_critical_client_routes(): void
    {
        global $pagenow;

        $current_user_id = get_current_user_id();
        if ($this->is_protected_admin($current_user_id)) {
            $policy = $this->get_protected_admin_policy($current_user_id);
            if (!empty($policy['block_code_tools'])) {
                if (in_array((string) $pagenow, ['plugin-editor.php', 'theme-editor.php'], true)) {
                    $this->deny();
                }

                if ((string) $pagenow === 'admin.php') {
                    $page = isset($_GET['page']) ? strtolower(sanitize_text_field(wp_unslash($_GET['page']))) : '';
                    if ($page === 'snippets' || str_starts_with($page, 'code-snippets')) {
                        $this->deny();
                    }
                }

                if (in_array((string) $pagenow, ['admin-ajax.php', 'admin-post.php'], true)) {
                    $action = isset($_REQUEST['action']) ? strtolower(sanitize_key(wp_unslash($_REQUEST['action']))) : '';
                    if ($action !== '' && str_contains($action, 'snippet')) {
                        $this->deny();
                    }
                }
            }
        }

        if (!$this->is_client_manager()) {
            return;
        }

        $blocked = [
            'plugins.php',
            'plugin-install.php',
            'plugin-editor.php',
            'themes.php',
            'theme-install.php',
            'theme-editor.php',
            'tools.php',
            'options-general.php',
            'options-writing.php',
            'options-reading.php',
            'options-discussion.php',
            'options-media.php',
            'options-permalink.php',
            'options-privacy.php',
            'users.php',
            'user-new.php',
            'update-core.php',
        ];

        if (in_array((string) $pagenow, $blocked, true)) {
            $this->deny();
        }

        if ((string) $pagenow === 'admin.php') {
            $page_raw = isset($_GET['page']) ? sanitize_text_field(wp_unslash($_GET['page'])) : '';
            $page = strtolower($page_raw);

            if (
                $page === 'bastionwp'
                || str_starts_with($page, 'wordfence')
                || $page === 'wfls'
                || str_starts_with($page, 'wfls_')
                || $page === 'snippets'
                || str_starts_with($page, 'code-snippets')
            ) {
                $this->deny();
            }
        }

        if (in_array((string) $pagenow, ['admin-ajax.php', 'admin-post.php'], true)) {
            $action = isset($_REQUEST['action'])
                ? strtolower(sanitize_key(wp_unslash($_REQUEST['action'])))
                : '';

            if (
                $action !== ''
                && (
                    str_contains($action, 'snippet')
                    || str_contains($action, 'wordfence')
                    || str_starts_with($action, 'wf')
                )
            ) {
                $this->deny();
            }
        }
    }

    public function hide_critical_client_menus(): void
    {
        $current_user_id = get_current_user_id();
        if ($this->is_protected_admin($current_user_id)) {
            $policy = $this->get_protected_admin_policy($current_user_id);
            if (!empty($policy['block_code_tools'])) {
                remove_menu_page('snippets');
                remove_menu_page('code-snippets');
            }
        }

        if (!$this->is_client_manager()) {
            return;
        }

        remove_menu_page('plugins.php');
        remove_menu_page('themes.php');
        remove_menu_page('tools.php');
        remove_menu_page('options-general.php');
        remove_menu_page('users.php');
        remove_menu_page('update-core.php');
        remove_menu_page('bastionwp');
        remove_menu_page('Wordfence');
        remove_menu_page('WFLS');
    }

    private function get_developer_ids(): array
    {
        $ids = get_option(self::DEVELOPERS_OPTION, []);

        if (!is_array($ids)) {
            return [];
        }

        return array_values(array_filter(array_unique(array_map('absint', $ids))));
    }

    private function is_developer(int $user_id): bool
    {
        return $user_id > 0 && in_array($user_id, $this->get_developer_ids(), true);
    }

    private function is_client_manager(): bool
    {
        $user = wp_get_current_user();

        if (!$user->exists()) {
            return false;
        }

        // Não usar user_can() aqui: allcaps já contém as capabilities resolvidas
        // do usuário e evita disparar novamente filtros de autorização.
        return !empty($user->allcaps[self::CLIENT_MARKER_CAP]);
    }

    private function is_protected_admin(int $user_id): bool
    {
        if ($user_id <= 0 || $this->is_developer($user_id)) {
            return false;
        }

        $user = get_userdata($user_id);
        return $user
            && in_array('administrator', (array) $user->roles, true)
            && (bool) get_user_meta($user_id, self::PROTECTED_ADMIN_META, true);
    }

    private function get_protected_admin_policy(int $user_id): array
    {
        $defaults = [
            'block_file_editor' => true,
            'block_code_tools' => true,
            'block_plugin_install' => false,
            'block_plugin_delete' => false,
            'block_plugin_activation' => false,
            'block_theme_install' => false,
            'block_theme_delete' => false,
            'block_theme_activation' => false,
            'block_users' => false,
            'block_updates' => false,
            'protect_bastion' => true,
            'protect_other_admins' => true,
        ];

        $saved = get_user_meta($user_id, self::PROTECTED_ADMIN_POLICY_META, true);
        if (!is_array($saved)) {
            $saved = [];
        }

        foreach ($defaults as $key => $default) {
            if (array_key_exists($key, $saved)) {
                $defaults[$key] = (bool) $saved[$key];
            }
        }

        return $defaults;
    }

    private function forbidden_client_capabilities(): array
    {
        return [
            'manage_options', 'edit_dashboard', 'customize', 'edit_theme_options',
            'manage_privacy_options', 'manage_links', 'import', 'export',
            'update_core', 'update_plugins', 'update_themes', 'install_plugins',
            'activate_plugins', 'deactivate_plugins', 'edit_plugins', 'delete_plugins',
            'install_themes', 'switch_themes', 'edit_themes', 'delete_themes',
            'create_users', 'edit_users', 'delete_users', 'promote_users',
            'remove_users', 'list_users', 'unfiltered_html', 'unfiltered_upload',
            'edit_files', 'install_languages', 'update_languages', 'manage_network',
            'manage_network_options', 'manage_network_plugins', 'manage_network_themes',
            'manage_network_users', 'setup_network', 'delete_site', 'bastionwp_manage',
        ];
    }

    private function deny(): void
    {
        wp_die(
            esc_html__('Seu perfil não possui permissão para acessar esta área técnica.', 'bastionwp'),
            esc_html__('Acesso bloqueado pelo BastionWP', 'bastionwp'),
            ['response' => 403, 'back_link' => true]
        );
    }
}

try {
    BastionWP_Core::instance();
} catch (Throwable $error) {
    // Nunca exibir detalhes sensíveis ao visitante. O erro vai apenas para
    // o log do servidor quando disponível.
    error_log(
        sprintf(
            '[BastionWP Core %s] Falha controlada na inicialização: %s',
            BASTION_CORE_VERSION,
            $error->getMessage()
        )
    );
}
